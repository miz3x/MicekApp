<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <ImageView android:id="@+id/widget_glass_edge" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/app_name"
            android:textColor="#F1F4FF" android:textSize="17sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_configure" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="⚙" android:textSize="20sp" android:textColor="#B8BFFF"
            android:contentDescription="Ustawienia widżetu" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="↻" android:textSize="23sp" android:textColor="#B8BFFF"
            android:contentDescription="Odśwież plan" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="5dp" android:textColor="#ABB7CC" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_columns" android:layout_width="match_parent"
        android:layout_height="24dp" android:gravity="center_vertical"
        android:paddingStart="6dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/column_start" android:layout_width="42dp" android:layout_height="wrap_content"
            android:text="Start" android:textSize="10sp" />
        <TextView android:id="@+id/column_subject" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Przedmiot" android:textSize="10sp" />
        <TextView android:id="@+id/column_room" android:layout_width="51dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="Sala" android:textSize="10sp" />
        <TextView android:id="@+id/column_end" android:layout_width="43dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="Koniec" android:textSize="10sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_lessons" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@drawable/widget_divider" android:dividerHeight="1dp" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:textColor="#F1F4FF" android:textSize="14sp"
            android:text="Dotknij, aby wybrać klasę" />
    </FrameLayout>
</LinearLayout>
</FrameLayout>
