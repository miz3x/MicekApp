<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp"
        android:paddingEnd="12dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:gravity="center_vertical"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_configure" android:layout_width="44dp" android:layout_height="match_parent"
                android:gravity="center" android:text="⚙" android:textSize="17sp" android:contentDescription="Ustawienia widżetu" />
            <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="match_parent"
                android:gravity="center" android:text="↻" android:textSize="20sp" android:contentDescription="Odśwież plan" />
        </LinearLayout>
        <TextView android:id="@+id/next_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:text="Wybierz klasę" />
        <LinearLayout android:id="@+id/next_lesson" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/next_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:gravity="center_vertical">
                <TextView android:id="@+id/next_subject" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
                    android:maxLines="2" android:ellipsize="end" />
                <Chronometer android:id="@+id/next_countdown" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/next_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
